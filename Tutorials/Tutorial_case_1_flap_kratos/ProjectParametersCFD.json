            "echo_level"                  : 1,
            "compute_reactions"           : true,
            "formulation": {
                "element_type": "qsvms",
                "use_orthogonal_subscales": false,
                "dynamic_tau": 1.0
            },
            "material_import_settings"    : {
                "materials_filename" : "FluidMaterials.json"
            },
            "maximum_iterations"          : 100,
            "relative_velocity_tolerance" : 1e-4,
