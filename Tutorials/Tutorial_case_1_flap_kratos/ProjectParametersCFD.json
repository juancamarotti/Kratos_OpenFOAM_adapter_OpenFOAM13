            //     "preconditioner_type": "relaxation",
            //     "verbosity" : 1
                "solver_type" : "LinearSolversApplication.pardiso_lu"
            }
        }
    },
    "processes"        : {
        "initial_conditions_process_list"  : [{
            "python_module" : "assign_vector_variable_process",
