{
    "problem_data" :
    {
        "start_time" : 0.0,
        "end_time" : 20.0,
        "echo_level" : 1,
        "print_colors" : true,
        "parallel_type" : "MPI"
    },
    "solver_settings" :
    {
        "type" : "coupled_solvers.gauss_seidel_weak",
        "echo_level" : 3,
        "predictors" : [
            {
                "type" : "average_value_based",
                "solver"         : "Openfoam_Kratos_Wrapper",
                "data_name"        : "load_interface_flap",
                "echo_level" : 1
            }
        ],
        "data_transfer_operators" : {
            "mapper" : {
                "type" : "kratos_mapping",
                "mapper_settings" : {
                    "mapper_type" : "nearest_neighbor_iga",
                    "echo_level" : 3,
                    "is_origin_iga": true, 
                    "search_settings" : {
                        "search_radius" : 0.20,
                        "max_num_search_iterations": 100
                    }
                }
            }
        },
        "coupling_sequence":
        [
        {
            "name": "structure",
            "input_data_list": [],
            "output_data_list": []
        },
        {
            "name": "Openfoam_Kratos_Wrapper",
            "input_data_list": [
                {
                    "data"           : "disp_interface_flap",
                    "from_solver"      : "structure",
                    "from_solver_data" : "disp_interface_flap",
                    "data_transfer_operator" : "mapper"
                }            ],
            "output_data_list": [
                 {
                    "data"              : "load_interface_flap",
                    "to_solver"       : "structure",
                    "to_solver_data"  : "load_interface_flap",
                    "data_transfer_operator" : "mapper",
                    "after_data_transfer_operations" : ["scaling_loads_interface_flap"],
                    "data_transfer_operator_options" : ["use_transpose"]
                }
            ]
        }
        ],
        "coupling_operations" : {
            "scaling_loads_interface_flap" : {
                "type"           : "scaling",
                "solver"         : "structure",
                "data_name"      : "load_interface_flap",
                "scaling_factor" : "(sin(((t)/0.005)/1000*pi/2))**2",
                "echo_level"     : 1,
                "interval"       : [0.0, 5.0]
            }
        },
        "solvers" :
        {
            "Openfoam_Kratos_Wrapper":
            {
                "type" : "solver_wrappers.external.openfoam_wrapper",
                "solver_wrapper_settings" : {
                    "import_meshes"    : ["interface_flap"],
                    "export_data"      : ["disp_interface_flap"],
                    "import_data"      : ["load_interface_flap"]
                },
                "io_settings" : {
                    "type"       : "kratos_co_sim_io",
                    "echo_level" : 4,
                    "connect_to" : "Openfoam_Adapter",
                    "communication_format" : "file"
                },
                "data" : {
                    "disp_interface_flap" : {
                        "model_part_name"   : "interface_flap",
                        "dimension" : 3,
                        "variable_name" : "DISPLACEMENT"
                    },
                    "load_interface_flap" : {
                        "model_part_name"   : "interface_flap",
                        "dimension" : 3,
                        "variable_name" : "FORCE"
                    }
                }
            },
            "structure" :
            {
                "type" : "solver_wrappers.kratos.structural_mechanics_wrapper",
                "solver_wrapper_settings" : {
                    "input_file"  : "ProjectParameters"
                },
                "data" : {
                    "disp_interface_flap" : {
                        "model_part_name" : "IgaModelPart.Load_3",
                        "variable_name" : "DISPLACEMENT",
                        "dimension" : 3
                    },
                    "load_interface_flap" : {
                        "model_part_name" : "IgaModelPart.Load_3",
                        "variable_name" : "POINT_LOAD",
                        "dimension" : 3
                    }
                }
            }
        }
    }
}
